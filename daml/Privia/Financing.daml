module Privia.Financing where

import Privia.Cash

-- The financier owns the right to collect from the buyer at maturity.
template FinancedReceivable
  with
    financier : Party
    supplier : Party
    buyer : Party
    invoiceId : Text
    faceAmount : Decimal
    currency : Text
    dueDate : Date
    advanceAmount : Decimal
  where
    signatory financier, supplier
    observer buyer

    choice FinancedReceivable_Settle : ContractId Cash
      with paymentCid : ContractId Cash
      controller buyer
      do exercise paymentCid Cash_Transfer with newOwner = financier
