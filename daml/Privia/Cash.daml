module Privia.Cash where

-- Minimal cash/IOU used for atomic delivery-versus-payment.
template Cash
  with
    issuer : Party
    owner : Party
    amount : Decimal
    currency : Text
  where
    signatory issuer
    observer owner
    ensure amount > 0.0

    choice Cash_Transfer : ContractId Cash
      with newOwner : Party
      controller owner
      do create this with owner = newOwner
