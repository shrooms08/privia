module Privia.Invoice where

-- An invoice issued by a supplier against a buyer. The supplier names the
-- financiers invited to bid; they see nothing until the buyer confirms.
template Invoice
  with
    supplier : Party
    buyer : Party
    invoiceId : Text
    faceAmount : Decimal
    currency : Text
    dueDate : Date
    financiers : [Party]
  where
    signatory supplier
    observer buyer
    ensure faceAmount > 0.0

    -- Buyer confirms the debt is real. Prevents fake-invoice fraud.
    choice Invoice_Acknowledge : ContractId AcknowledgedInvoice
      controller buyer
      do create AcknowledgedInvoice with
           supplier; buyer; invoiceId; faceAmount; currency; dueDate; financiers

-- A buyer-confirmed receivable. Financing CONSUMES this contract, which is
-- what structurally prevents the same invoice being financed twice.
-- Invited financiers observe it only from this point: they only ever see
-- confirmed debt, never unverified invoices.
template AcknowledgedInvoice
  with
    supplier : Party
    buyer : Party
    invoiceId : Text
    faceAmount : Decimal
    currency : Text
    dueDate : Date
    financiers : [Party]
  where
    signatory supplier
    observer buyer, financiers
